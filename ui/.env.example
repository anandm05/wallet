# Copy to .env.local and fill in.
# Backend base URL (the Spring Boot app).
VITE_API_BASE_URL=http://localhost:8080
# Cognito hosted-UI domain, without https://
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
# Client ID of the `wallet-ui` app client (Authorization Code + PKCE, no secret)
VITE_COGNITO_CLIENT_ID=
# Scopes allowed on that app client. Add wallet-api/admin for admin users.
VITE_COGNITO_SCOPES=openid email profile
# Optional overrides; defaults are <origin>/callback and <origin>
# VITE_REDIRECT_URI=http://localhost:3000/callback
# VITE_LOGOUT_URI=http://localhost:3000
